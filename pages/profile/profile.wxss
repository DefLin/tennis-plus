.profile-page { min-height: 100vh; background: #f7f8f3; }
.profile-hero { min-height: 360rpx; padding: 30rpx 34rpx 82rpx; background: #154734; color: #fff; position: relative; overflow: hidden; }
.profile-hero::after { content: ''; position: absolute; width: 290rpx; height: 290rpx; border: 2rpx solid rgba(223,243,106,.12); border-radius: 50%; right: -60rpx; top: 18rpx; }
.brand-row { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 2; }
.brand { font-size: 32rpx; font-weight: 900; letter-spacing: 2rpx; }
.brand text { color: #dff36a; font-size: 12rpx; margin-left: 5rpx; vertical-align: top; }
.login-state { height: 46rpx; padding: 0 16rpx; border-radius: 999rpx; display: flex; align-items: center; background: rgba(255,255,255,.1); color: #dce8df; font-size: 20rpx; }
.login-state text { width: 12rpx; height: 12rpx; border-radius: 50%; background: #dff36a; margin-right: 8rpx; }
.user-block { display: flex; align-items: center; min-height: 126rpx; margin-top: 40rpx; position: relative; z-index: 2; }
.big-avatar { width: 114rpx; height: 114rpx; min-width: 114rpx; padding: 0; border: 5rpx solid rgba(255,255,255,.3); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #154734; background: #dff36a; font-size: 34rpx; font-weight: 800; line-height: 1; overflow: hidden; }
.big-avatar::after { border: 0; }
.big-avatar image { width: 100%; height: 100%; }
.avatar-button { margin: 0; }
.user-copy { flex: 1; min-width: 0; margin-left: 22rpx; }
.user-copy view { font-size: 36rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-copy text { display: block; margin-top: 9rpx; color: #b7c8bd; font-size: 22rpx; }
.edit { flex: none; color: #d8e4db; font-size: 22rpx; margin-left: 12rpx; }
.guest-wrap { position: relative; z-index: 2; }
.guest { margin-top: 34rpx; }
.guest .big-avatar { background: #fff; color: #154734; }
.wechat-login { margin: 24rpx 0 0 136rpx; width: 338rpx; height: 76rpx; line-height: 76rpx; border-radius: 999rpx; border: 0; background: #13a850; color: #fff; font-size: 24rpx; font-weight: 700; }
.wechat-login::after { border: 0; }
.wechat-login text { margin-right: 9rpx; }
.loading-user { opacity: .75; }
.skeleton { background: rgba(255,255,255,.14); }

.profile-content { padding: 0 28rpx calc(50rpx + env(safe-area-inset-bottom)); }
.stats { position: relative; z-index: 3; margin-top: -49rpx; display: flex; padding: 25rpx 0; }
.stats>view { flex: 1; text-align: center; }
.stats>view + view { border-left: 1rpx solid #e8ebe6; }
.stats text { font-size: 36rpx; color: #154734; font-weight: 800; }
.stats view view { color: #858c86; margin-top: 5rpx; font-size: 20rpx; }
.edit-card { padding: 27rpx; margin-top: 21rpx; }
.edit-title { font-size: 28rpx; font-weight: 750; }
.nickname-field { height: 91rpx; display: flex; align-items: center; margin-top: 14rpx; border-top: 1rpx solid #ecefe9; border-bottom: 1rpx solid #ecefe9; }
.nickname-field>text { width: 110rpx; color: #59625b; font-size: 24rpx; }
.nickname-field input { flex: 1; height: 64rpx; padding: 0 17rpx; border-radius: 16rpx; background: #f6f7f3; font-size: 24rpx; }
.edit-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 20rpx; }
.edit-actions button { margin: 0; width: 145rpx; height: 64rpx; line-height: 64rpx; border: 0; border-radius: 999rpx; background: #eef1eb; color: #154734; font-size: 22rpx; }
.edit-actions button::after { border: 0; }
.edit-actions .save { color: #fff; background: #154734; }
.level-card { padding: 27rpx; margin-top: 21rpx; }
.level-top { display: flex; align-items: center; justify-content: space-between; }
.level-top>view:first-child>text { color: #8b918c; font-size: 20rpx; }
.level-top>view:first-child>view { margin-top: 5rpx; font-size: 29rpx; font-weight: 750; }
.level-badge { color: #154734; background: #dff36a; padding: 10rpx 15rpx; border-radius: 12rpx; font-size: 21rpx; font-weight: 800; }
.progress { height: 10rpx; background: #e8ebe5; border-radius: 10rpx; overflow: hidden; margin: 20rpx 0 12rpx; }
.progress view { height: 100%; border-radius: 10rpx; background: #154734; }
.level-card>text { color: #858c86; font-size: 20rpx; }
.menu { margin-top: 21rpx; padding: 3rpx 26rpx; }
.menu-item { min-height: 110rpx; display: flex; align-items: center; }
.menu-item + .menu-item { border-top: 1rpx solid #ecefe9; }
.menu-icon { width: 58rpx; height: 58rpx; border-radius: 18rpx; background: #eef3ed; color: #154734; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.menu-copy { flex: 1; min-width: 0; margin-left: 17rpx; }
.menu-copy view { font-size: 26rpx; font-weight: 650; }
.menu-copy text { display: block; color: #929892; font-size: 20rpx; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.arrow { color: #9aa09b; font-size: 35rpx; }
.logout { margin: 24rpx 0 0; width: 100%; height: 82rpx; line-height: 82rpx; border: 0; border-radius: 23rpx; color: #a04a4a; background: #fff; font-size: 25rpx; }
.logout::after { border: 0; }
.version { text-align: center; color: #b0b5b0; font-size: 19rpx; margin-top: 28rpx; }
