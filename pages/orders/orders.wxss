.orders-page { padding-top: 22rpx; }.order { padding: 0 25rpx; margin-bottom: 21rpx; }.order-head { height: 78rpx; border-bottom: 1rpx solid #ecefe9; display: flex; align-items: center; justify-content: space-between; color: #929792; font-size: 20rpx; }.status { color: #25804f; font-weight: 650; }.status.cancelled { color: #999; }.order-main { padding: 22rpx 0; display: flex; }.thumb { width: 150rpx; height: 132rpx; border-radius: 18rpx; display: flex; align-items: flex-end; padding: 13rpx; color: #fff; overflow: hidden; }.thumb text { font-weight: 800; font-style: italic; }.info { flex: 1; padding: 5rpx 0 0 19rpx; }.info view { font-size: 27rpx; font-weight: 700; }.info text { display: block; color: #7e857f; font-size: 21rpx; margin-top: 10rpx; }.order-foot { min-height: 92rpx; border-top: 1rpx solid #ecefe9; display: flex; align-items: center; }.order-foot>view { margin-right: auto; color: #858c86; font-size: 20rpx; }.order-foot>view text { color: #18211b; font-size: 28rpx; font-weight: 750; }.order-foot button { margin: 0 0 0 10rpx; padding: 0 18rpx; height: 59rpx; line-height: 59rpx; border: 1rpx solid #dfe3dd; border-radius: 999rpx; background: #fff; color: #687069; font-size: 21rpx; }.order-foot button::after { border: 0; }.order-foot .primary { color: #fff; background: #154734; border-color: #154734; }
