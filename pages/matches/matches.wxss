.match-page { padding-top: 18rpx; }.match-hero { height: 292rpx; padding: 37rpx; border-radius: 30rpx; color: #fff; background: #154734; position: relative; overflow: hidden; }.kicker { color: #b7c9bd; font-size: 17rpx; letter-spacing: 3rpx; }.hero-title { margin-top: 15rpx; font-size: 43rpx; font-weight: 800; line-height: 1.25; }.match-hero button { position: absolute; right: 28rpx; bottom: 28rpx; margin: 0; height: 68rpx; line-height: 68rpx; padding: 0 23rpx; border: 0; border-radius: 999rpx; background: #dff36a; color: #163818; font-size: 24rpx; font-weight: 750; }.match-hero button::after { border: 0; }
.balls { position: absolute; right: 31rpx; top: 22rpx; width: 235rpx; height: 170rpx; }.balls view { position: absolute; border-radius: 50%; background: #dff36a; box-shadow: -8rpx 12rpx 20rpx rgba(0,0,0,.13); }.balls view:nth-child(1) { width: 75rpx; height: 75rpx; right: 72rpx; top: 21rpx; }.balls view:nth-child(2) { width: 33rpx; height: 33rpx; right: 0; top: 72rpx; opacity: .6; }.balls view:nth-child(3) { width: 18rpx; height: 18rpx; left: 20rpx; top: 9rpx; opacity: .35; }
.tab-scroll { width: calc(100vw - 28rpx); margin-right: -28rpx; }.tabs { display: flex; gap: 14rpx; padding: 26rpx 28rpx 22rpx 0; }.tab { flex: none; padding: 16rpx 28rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #e1e5df; color: #6f7770; font-size: 24rpx; }.tab.active { color: #fff; background: #154734; border-color: #154734; }
.list-head { display: flex; align-items: center; justify-content: space-between; margin: 10rpx 4rpx 19rpx; }.list-head view>text:first-child { font-size: 32rpx; font-weight: 750; }.list-head>text { color: #7a817b; font-size: 22rpx; }.count { margin-left: 10rpx; font-size: 20rpx; color: #809087; background: #edf1ed; padding: 5rpx 10rpx; border-radius: 999rpx; }
.match-card { padding: 27rpx; margin-bottom: 20rpx; }.host-row { display: flex; align-items: center; }.avatar.color-0 { background: #d8eadb; }.avatar.color-1 { background: #f5dfc8; color: #9b5c2f; }.avatar.color-2 { background: #dce1ef; color: #40577d; }.host { flex: 1; margin-left: 16rpx; }.host>view { font-size: 26rpx; font-weight: 700; }.host>view text { margin-left: 7rpx; padding: 5rpx 9rpx; color: #154734; border-radius: 8rpx; background: #edf4ee; font-size: 18rpx; }.host>text { display: block; margin-top: 7rpx; color: #929792; font-size: 20rpx; }.type { border: 1rpx solid #dfe4de; color: #646c65; border-radius: 999rpx; padding: 8rpx 15rpx; font-size: 21rpx; }
.title { margin-top: 23rpx; font-size: 31rpx; font-weight: 750; }.info-panel { margin-top: 19rpx; padding: 17rpx 20rpx; border-radius: 18rpx; background: #f6f7f3; color: #465149; font-size: 23rpx; }.info-panel view + view { margin-top: 12rpx; }.info-icon { display: inline-block; width: 37rpx; color: #154734; }.distance { color: #939993; margin-left: 7rpx; }
.level-row { display: flex; align-items: center; margin-top: 19rpx; color: #858b86; font-size: 20rpx; }.level-bar { flex: 1; height: 8rpx; margin: 0 13rpx; border-radius: 9rpx; background: #e5e9e3; overflow: hidden; }.level-bar view { height: 100%; background: #dff36a; }.level-row>text:last-child { color: #154734; font-weight: 650; }
.match-bottom { border-top: 1rpx solid #ecefea; display: flex; align-items: center; margin-top: 20rpx; padding-top: 21rpx; }.spots { display: flex; align-items: center; color: #7c837d; font-size: 20rpx; }.people { letter-spacing: -5rpx; margin-right: 8rpx; color: #d7dcd6; }.people .filled { color: #154734; }.fee { margin-left: auto; font-size: 19rpx; color: #7d847e; }.fee text { color: #154734; font-size: 27rpx; font-weight: 750; }.match-bottom button { margin: 0 0 0 15rpx; height: 64rpx; line-height: 64rpx; padding: 0 22rpx; border: 0; border-radius: 999rpx; background: #154734; color: #fff; font-size: 22rpx; font-weight: 650; }.match-bottom button::after { border: 0; }.empty { text-align: center; color: #8b918c; padding: 130rpx 0; }
