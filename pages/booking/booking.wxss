.booking-page { padding-bottom: 170rpx; }.order-card { display: flex; padding: 20rpx; }.venue-thumb { width: 190rpx; height: 168rpx; border-radius: 20rpx; position: relative; overflow: hidden; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; padding: 16rpx; }.venue-thumb text { position: relative; z-index: 2; font-weight: 800; font-style: italic; }.court-mark { position: absolute; font-size: 150rpx; font-weight: 200; opacity: .15; right: 15rpx; top: -17rpx; }.venue-info { flex: 1; padding: 10rpx 5rpx 5rpx 22rpx; color: #737a74; font-size: 21rpx; }.venue-info .name { color: #18211b; font-size: 29rpx; font-weight: 750; margin-bottom: 12rpx; }.venue-info text { display: block; margin-top: 16rpx; color: #154734; font-size: 24rpx; font-weight: 700; }
.section-label { font-size: 31rpx; font-weight: 750; margin: 39rpx 4rpx 17rpx; }.form-card, .cost-card { padding: 3rpx 27rpx; }.field { min-height: 94rpx; display: flex; align-items: center; }.field + .field { border-top: 1rpx solid #ecefe9; }.field>text { width: 150rpx; font-weight: 650; }.field input { flex: 1; text-align: right; font-size: 25rpx; }
.cost-card>view { height: 86rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; }.cost-card>view + view { border-top: 1rpx solid #eef0ec; }.cost-card .coupon text:last-child { color: #8b918c; }.cost-card .total-line { height: 102rpx; font-weight: 700; }.total-line view { color: #154734; font-size: 24rpx; }.total-line view>text { color: #9a9f9a; font-size: 20rpx; margin-right: 12rpx; font-weight: 400; }
.demo-note { display: flex; align-items: center; margin-top: 22rpx; border-radius: 22rpx; padding: 18rpx 21rpx; background: #eef4e4; color: #65705e; font-size: 21rpx; }.demo-note>text { color: #154734; background: #dff36a; border-radius: 9rpx; padding: 7rpx 9rpx; font-size: 18rpx; font-weight: 800; margin-right: 14rpx; }.demo-note view view:first-child { color: #264633; font-weight: 650; margin-bottom: 3rpx; }
.agreement { display: flex; align-items: center; margin: 27rpx 7rpx; color: #777e78; font-size: 22rpx; }.checkbox { width: 31rpx; height: 31rpx; border-radius: 8rpx; border: 2rpx solid #cbd0ca; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; font-size: 19rpx; }.checkbox.checked { border-color: #154734; background: #154734; color: #fff; }
.paybar { position: fixed; z-index: 5; bottom: 0; left: 0; right: 0; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; display: flex; align-items: center; box-shadow: 0 -8rpx 30rpx rgba(20,40,30,.07); }.amount { flex: 1; font-size: 21rpx; color: #7d847e; }.amount view { display: inline; color: #154734; margin-left: 9rpx; font-weight: 700; }.amount view text { font-size: 39rpx; }.pay-btn { margin: 0; width: 330rpx; height: 88rpx; line-height: 88rpx; border-radius: 999rpx; background: #13a850; color: #fff; font-size: 28rpx; font-weight: 750; }.pay-btn::after { border: 0; }.wechat { margin-right: 9rpx; }
