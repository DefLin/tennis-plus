.courts-page { padding-top: 22rpx; }
.search-row { display: flex; gap: 16rpx; }
.search-box { flex: 1; height: 82rpx; border-radius: 22rpx; background: #fff; display: flex; align-items: center; padding: 0 24rpx; box-shadow: 0 8rpx 25rpx rgba(21,71,52,.05); }
.search-icon { font-size: 36rpx; margin-right: 13rpx; color: #154734; }.search-box input { flex: 1; font-size: 26rpx; }
.map-toggle { width: 92rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: #fff; background: #154734; font-size: 24rpx; font-weight: 650; }
.location-row { display: flex; align-items: center; color: #154734; font-size: 24rpx; margin: 19rpx 5rpx 8rpx; }.location-row text:first-of-type { margin-left: 7rpx; color: #5e675f; }.locate { margin-left: auto!important; color: #154734!important; }
.filter-scroll { width: calc(100vw - 28rpx); margin-right: -28rpx; }.filter-row { display: flex; gap: 13rpx; padding: 18rpx 28rpx 20rpx 0; }.filter { flex: none; border-radius: 999rpx; border: 1rpx solid #dfe4dc; background: #fff; color: #555d56; padding: 16rpx 24rpx; font-size: 23rpx; }.filter.active { color: #fff; border-color: #154734; background: #154734; }
.result-head { display: flex; justify-content: space-between; margin: 10rpx 4rpx 19rpx; font-weight: 700; }.result-head .muted { font-size: 21rpx; font-weight: 400; }
.map-wrap { position: relative; }
.venue-map { width: 100%; height: 970rpx; border-radius: 28rpx; overflow: hidden; margin-top: 4rpx; }
.map-status { position: absolute; top: 22rpx; left: 50%; transform: translateX(-50%); padding: 13rpx 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.94); color: #526058; font-size: 21rpx; box-shadow: 0 7rpx 22rpx rgba(21,71,52,.12); white-space: nowrap; }
.venue-list-card { display: flex; padding: 19rpx; margin-bottom: 20rpx; }
.venue-thumb { position: relative; width: 220rpx; height: 260rpx; flex: none; border-radius: 22rpx; overflow: hidden; color: #fff; }
.mini-court { position: absolute; width: 145rpx; height: 180rpx; left: 38rpx; top: 39rpx; border: 3rpx solid rgba(255,255,255,.38); transform: rotate(13deg); }.mini-court::after { content: ''; position: absolute; width: 100%; height: 2rpx; background: rgba(255,255,255,.4); top: 50%; }.net { position: absolute; height: 100%; width: 2rpx; left: 50%; background: rgba(255,255,255,.4); }
.thumb-name { position: absolute; left: 16rpx; bottom: 19rpx; font-size: 21rpx; font-weight: 800; letter-spacing: 2rpx; }.thumb-label { position: absolute; top: 14rpx; left: 14rpx; padding: 6rpx 10rpx; border-radius: 999rpx; font-size: 18rpx; color: #213217; background: #dff36a; }
.venue-content { flex: 1; min-width: 0; padding: 5rpx 3rpx 1rpx 22rpx; }.name-line { display: flex; align-items: flex-start; }.name { flex: 1; font-size: 29rpx; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.distance { margin-left: 10rpx; font-size: 22rpx; color: #747c75; }
.rating { margin-top: 11rpx; font-size: 21rpx; color: #8a908a; }.rating text { color: #d29b25; }.address { margin-top: 10rpx; color: #6e766f; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tag-row { display: flex; gap: 7rpx; margin-top: 15rpx; overflow: hidden; }.tag-row .outline-tag { height: 34rpx; font-size: 18rpx; padding: 0 9rpx; }
.bottom-line { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 21rpx; }.price { font-size: 34rpx; color: #154734; font-weight: 800; }.unit { font-size: 18rpx; color: #858c86; }.book-pill { padding: 8rpx 13rpx; color: #30694e; background: #eaf4ed; font-size: 19rpx; border-radius: 999rpx; }
.map-source { color: #858c86; font-size: 19rpx; }
.empty { height: 500rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #606760; }.empty-ball { width: 80rpx; height: 80rpx; border-radius: 50%; background: #dff36a; color: rgba(255,255,255,.5); display: flex; align-items: center; justify-content: center; margin-bottom: 22rpx; }.empty text { color: #969c97; margin-top: 9rpx; font-size: 23rpx; }
