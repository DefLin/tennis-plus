.home { padding: calc(env(safe-area-inset-top) + 26rpx) 28rpx 46rpx; overflow: hidden; }
.topbar { height: 106rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { font-size: 40rpx; line-height: 46rpx; font-weight: 900; letter-spacing: 2rpx; color: #154734; }
.brand-dot { margin-left: 5rpx; font-size: 16rpx; color: #dff36a; vertical-align: top; }
.location { margin-top: 6rpx; color: #626961; font-size: 23rpx; }
.chevron { margin-left: 5rpx; }
.top-actions { display: flex; gap: 16rpx; align-items: center; }
.round-action { width: 68rpx; height: 68rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; box-shadow: 0 7rpx 22rpx rgba(21,71,52,.07); }
.avatar.mini { width: 68rpx; height: 68rpx; font-size: 24rpx; background: #154734; color: #fff; }
.hero { position: relative; height: 390rpx; overflow: hidden; margin-top: 18rpx; padding: 48rpx 40rpx; color: #fff; background: #154734; box-shadow: 0 20rpx 46rpx rgba(21,71,52,.2); }
.hero-copy { position: relative; z-index: 3; }
.hero-kicker { font-size: 18rpx; letter-spacing: 3rpx; color: #c9d9c5; }
.hero-title { font-size: 57rpx; line-height: 1.12; font-weight: 800; margin-top: 17rpx; letter-spacing: 1rpx; }
.hero-sub { margin-top: 14rpx; font-size: 23rpx; color: rgba(255,255,255,.68); }
.hero-btn { margin: 28rpx 0 0; width: 218rpx; height: 68rpx; line-height: 68rpx; border: 0; border-radius: 999rpx; font-size: 25rpx; font-weight: 700; background: #dff36a; color: #173916; padding: 0; }
.hero-btn::after { border: 0; }
.hero-btn text { margin-left: 12rpx; }
.tennis-art { position: absolute; z-index: 1; right: -42rpx; top: 0; width: 350rpx; height: 390rpx; transform: rotate(-4deg); }
.sun { position: absolute; width: 250rpx; height: 250rpx; border-radius: 50%; background: rgba(223,243,106,.08); right: 3rpx; top: 20rpx; }
.court-line { position: absolute; height: 1rpx; background: rgba(255,255,255,.18); width: 420rpx; transform: rotate(-25deg); right: -80rpx; }
.line-a { top: 105rpx; }.line-b { top: 300rpx; }
.racket { position: absolute; width: 154rpx; height: 194rpx; right: 54rpx; top: 73rpx; border: 13rpx solid #f4eee0; border-radius: 50%; transform: rotate(31deg); box-shadow: inset 0 0 0 5rpx #809687; }
.racket::after { content: ''; position: absolute; bottom: -110rpx; left: 58rpx; width: 25rpx; height: 116rpx; border-radius: 12rpx; background: #c88957; }
.racket-net { position: absolute; opacity: .35; background: #fff; }
.net-a { width: 1rpx; height: 158rpx; left: 68rpx; top: 5rpx; }.net-b { height: 1rpx; width: 125rpx; left: 3rpx; top: 79rpx; }
.ball { position: absolute; right: 9rpx; top: 37rpx; width: 56rpx; height: 56rpx; background: #dff36a; border-radius: 50%; box-shadow: -7rpx 9rpx 22rpx rgba(0,0,0,.16); }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 24rpx; }
.quick { display: flex; align-items: center; position: relative; padding: 24rpx 20rpx; }
.quick-icon { width: 66rpx; height: 66rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 15rpx; }
.green-bg { background: #154734; color: #fff; }.lime-bg { background: #dff36a; color: #154734; }
.quick-title { font-size: 28rpx; font-weight: 750; }.quick-sub { font-size: 21rpx; color: #8b918b; margin-top: 5rpx; }.quick-arrow { position: absolute; right: 17rpx; color: #a2a7a1; font-size: 35rpx; }
.venue-scroll { width: calc(100vw - 28rpx); overflow: visible; margin-right: -28rpx; }
.venue-row { display: flex; gap: 20rpx; padding: 2rpx 28rpx 22rpx 0; }
.venue-card { width: 520rpx; flex: none; overflow: hidden; }
.venue-cover { height: 214rpx; position: relative; overflow: hidden; color: #fff; }
.cover-word { position: absolute; right: -7rpx; bottom: -13rpx; font-size: 74rpx; font-style: italic; font-weight: 900; opacity: .15; letter-spacing: -4rpx; }
.cover-tag { position: absolute; top: 20rpx; left: 20rpx; }
.court-mini { position: absolute; width: 255rpx; height: 133rpx; border: 2rpx solid rgba(255,255,255,.5); transform: perspective(320rpx) rotateX(55deg) rotateZ(-12deg); right: 25rpx; top: 45rpx; }
.court-mini-line { position: absolute; background: rgba(255,255,255,.45); }.court-mini-line.vertical { height: 100%; width: 2rpx; left: 50%; }.court-mini-line.horizontal { width: 100%; height: 2rpx; top: 50%; }
.venue-body { padding: 23rpx 24rpx 25rpx; }.venue-name { font-size: 30rpx; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.venue-meta { margin-top: 10rpx; font-size: 23rpx; color: #737b74; }.star { color: #e2a82d; }.dot { margin: 0 5rpx; }
.venue-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }.price { font-size: 35rpx; font-weight: 800; color: #154734; }.unit { color: #939994; font-size: 21rpx; }.slots { color: #327052; font-size: 22rpx; background: #edf5ef; padding: 8rpx 14rpx; border-radius: 999rpx; }
.date-strip { display: flex; justify-content: space-around; padding: 14rpx 9rpx; margin-bottom: 18rpx; }.date-item { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 104rpx; height: 105rpx; border-radius: 23rpx; }.date-label { color: #858c86; font-size: 21rpx; }.date-day { margin-top: 4rpx; font-size: 29rpx; font-weight: 700; }.date-item.active { background: #154734; color: #fff; }.date-item.active .date-label { color: #dff36a; }
.match-card { padding: 25rpx; margin-bottom: 18rpx; }.match-top { display: flex; align-items: flex-start; }.host-info { flex: 1; margin-left: 17rpx; min-width: 0; }.host-name { font-size: 26rpx; font-weight: 700; }.level { height: 34rpx; padding: 0 10rpx; margin-left: 7rpx; font-size: 18rpx; }.match-title { font-size: 28rpx; font-weight: 700; margin-top: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.match-details { background: #f6f7f3; border-radius: 18rpx; padding: 16rpx 20rpx; margin-top: 19rpx; color: #154734; font-size: 23rpx; }.match-details view + view { margin-top: 11rpx; }.match-details text { color: #555e57; margin-left: 8rpx; }
.match-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }.player-state { color: #777e78; font-size: 21rpx; }.player-dots { color: #154734; letter-spacing: -4rpx; margin-right: 8rpx; }.join-btn { margin: 0; height: 62rpx; line-height: 62rpx; border: 0; border-radius: 999rpx; padding: 0 25rpx; color: #fff; background: #154734; font-size: 23rpx; font-weight: 650; }.join-btn::after { border: 0; }
