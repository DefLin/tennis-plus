.detail-page { padding-bottom: 150rpx; }.venue-hero { height: 470rpx; position: relative; overflow: hidden; color: #fff; }.hero-label { position: absolute; top: 29rpx; left: 29rpx; z-index: 2; }.favorite { position: absolute; right: 29rpx; top: 29rpx; width: 71rpx; height: 71rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 39rpx; background: rgba(0,0,0,.18); }.favorite.on { background: #fff; color: #d55656; }
.hero-court { position: absolute; width: 470rpx; height: 290rpx; left: 165rpx; top: 96rpx; border: 5rpx solid rgba(255,255,255,.55); transform: perspective(400rpx) rotateX(42deg) rotateZ(-16deg); }.hero-court::after { content: ''; position: absolute; left: 50%; width: 4rpx; height: 100%; background: rgba(255,255,255,.5); }.hero-net { position: absolute; top: 50%; width: 100%; height: 4rpx; background: rgba(255,255,255,.6); }.service-line { position: absolute; width: 55%; height: 48%; left: 22.5%; top: 26%; border: 3rpx solid rgba(255,255,255,.42); }
.hero-logo { position: absolute; left: 34rpx; bottom: 30rpx; font-size: 66rpx; font-weight: 900; font-style: italic; letter-spacing: 3rpx; opacity: .24; }
.content { padding: 0 28rpx; }.info-card { position: relative; margin-top: -25rpx; z-index: 2; padding: 30rpx; }.name-row { display: flex; align-items: flex-start; }.name-row>view:first-child { flex: 1; min-width: 0; }.venue-name { font-size: 37rpx; font-weight: 800; }.rating { margin-top: 11rpx; color: #777e78; font-size: 22rpx; }.rating text { color: #d69e26; }.distance { color: #154734; font-size: 23rpx; font-weight: 650; margin: 7rpx 0 0 13rpx; }.tag-row { display: flex; gap: 10rpx; margin-top: 22rpx; }
.address-row { display: flex; align-items: center; border-top: 1rpx solid #edf0ea; margin-top: 25rpx; padding-top: 23rpx; }.pin { width: 52rpx; height: 52rpx; border-radius: 17rpx; background: #edf5ef; color: #154734; display: flex; align-items: center; justify-content: center; }.address { flex: 1; margin-left: 15rpx; font-size: 25rpx; }.address text { color: #8a918a; font-size: 21rpx; margin-top: 6rpx; }.arrow { font-size: 39rpx; color: #949a95; }
.actions { display: flex; border-top: 1rpx solid #edf0ea; margin-top: 22rpx; padding-top: 22rpx; color: #154734; font-size: 24rpx; font-weight: 650; }.actions view { flex: 1; text-align: center; }.actions view + view { border-left: 1rpx solid #e6e9e3; }
.section-caption { color: #8b918b; font-size: 21rpx; margin-top: 5rpx; }.date-scroll { width: calc(100vw - 28rpx); margin-right: -28rpx; }.date-row { display: flex; gap: 13rpx; padding: 2rpx 28rpx 8rpx 0; }.date { flex: none; width: 103rpx; height: 112rpx; border-radius: 22rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #eaede7; }.date text { font-size: 21rpx; color: #858c86; }.date view { font-size: 31rpx; margin-top: 4rpx; font-weight: 700; }.date.active { background: #154734; color: #fff; border-color: #154734; }.date.active text { color: #dff36a; }
.slot-head { margin-bottom: 18rpx; }.legend { font-size: 20rpx; color: #878d87; display: flex; align-items: center; }.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #dff36a; margin-right: 6rpx; }.legend-dot.busy { background: #d8dcd7; margin-left: 16rpx; }.slot-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13rpx; }.slot { height: 103rpx; border: 2rpx solid #dce2da; border-radius: 19rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }.slot-time { font-size: 27rpx; font-weight: 700; }.slot-price { font-size: 19rpx; color: #47735f; margin-top: 5rpx; }.slot.busy { background: #ebede9; color: #a4a8a4; border-color: #ebede9; }.slot.busy .slot-price { color: #a4a8a4; }.slot.selected { background: #dff36a; border-color: #dff36a; color: #173819; }.slot.selected .slot-price { color: #173819; }
.notice { margin-top: 39rpx; padding: 26rpx 29rpx; color: #7a817b; font-size: 22rpx; line-height: 1.85; }.notice-title { color: #29332c; font-size: 27rpx; font-weight: 700; margin-bottom: 8rpx; }
.booking-bar { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; min-height: 126rpx; padding: 17rpx 28rpx calc(17rpx + env(safe-area-inset-bottom)); background: #fff; display: flex; align-items: center; box-shadow: 0 -8rpx 30rpx rgba(20,40,30,.08); }.selection { flex: 1; color: #154734; font-size: 25rpx; font-weight: 700; }.selection view { color: #878d87; font-size: 19rpx; font-weight: 400; margin-top: 5rpx; }.submit { width: 240rpx; margin: 0; height: 82rpx; line-height: 82rpx; font-size: 26rpx; }
