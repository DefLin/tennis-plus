NODE_ENV=production
PORT=3000

# 小程序配置（AppSecret 只放在服务器）
WECHAT_APP_ID=wx325e1bb54285c3ff
WECHAT_APP_SECRET=replace-with-wechat-app-secret

# 微信支付 API v3
WECHAT_MCH_ID=replace-with-merchant-id
WECHAT_MCH_SERIAL_NO=replace-with-merchant-cert-serial
WECHAT_API_V3_KEY=replace-with-32-byte-api-v3-key
WECHAT_PRIVATE_KEY_PATH=/app/keys/apiclient_key.pem
WECHAT_PLATFORM_CERT_PATH=/app/keys/wechatpay_platform.pem
WECHAT_PAY_NOTIFY_URL=https://api.deflin.xyz/v1/payments/wechat/notify

# 数据库和业务安全
DATABASE_URL=mysql://tennis:replace-with-password@mysql:3306/tennis
JWT_SECRET=replace-with-a-long-random-secret
BOOKING_HOLD_MINUTES=15
CORS_ORIGIN=*
